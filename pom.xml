<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>kr.scfarm</groupId>
    <artifactId>MenuPlugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>MenuPlugin</name>
    <description>완전 config 기반 메뉴 플러그인 (마인팜)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!--
          paper-api 버전 — 26.1부터 표기 방식이 바뀜(구 -R0.1-SNAPSHOT 폐지).
          새 형식: {버전}.build.{빌드번호}-{상태}   예) 26.2.build.56-alpha, 26.1.2.build.23-alpha
          존재하는 버전 목록(브라우저에서 열어 확인):
            https://repo.papermc.io/service/rest/repository/browse/maven-public/io/papermc/paper/paper-api/
          안정판(26.1.2)을 쓰려면 위 목록에서 26.1.2.build.N 계열 최신 항목을 골라 그대로 적을 것.
        -->
        <paper.version>26.2.build.56-alpha</paper.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <!-- paper-api 는 SNAPSHOT 배포 → snapshot 해석 명시 + 캐시된 실패를
                 무시하고 항상 재확인하도록 updatePolicy 지정 -->
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
        <!-- Nexo (소프트 의존, 선택) -->
        <repository>
            <id>nexo</id>
            <url>https://repo.nexomc.com/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (26.x MojMap, 순정 paper-api 로 컴파일) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Nexo (glyph/shift, nexo-item). 소프트 의존 — 없어도 우아하게 저하.
             실제로는 런타임 리플렉션으로 연동하므로 컴파일에는 강제되지 않음.
             좌표(버전)를 아는 경우 아래 주석 해제해 컴파일 타임 연동 가능.
        <dependency>
            <groupId>com.nexomc</groupId>
            <artifactId>nexo</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>
        -->
    </dependencies>

    <build>
        <!-- IntelliJ/Maven 빌드 시 접미사 방지 → 결과물: target/MenuPlugin.jar -->
        <finalName>MenuPlugin</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>
</project>
