<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>kr.scfarm</groupId>
    <artifactId>MenuPlugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>MenuPlugin</name>
    <description>완전 config 기반 메뉴 플러그인 (마인팜)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Paper 26.2(실험) / 안정 26.1.2 로 교체 가능. 26.x는 MojMap → 리매핑 불필요. -->
        <paper.version>26.2-R0.1-SNAPSHOT</paper.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- Nexo (소프트 의존, 선택) -->
        <repository>
            <id>nexo</id>
            <url>https://repo.nexomc.com/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (26.x MojMap, 순정 paper-api 로 컴파일) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Nexo (glyph/shift, nexo-item). 소프트 의존 — 없어도 우아하게 저하.
             실제로는 런타임 리플렉션으로 연동하므로 컴파일에는 강제되지 않음.
             좌표(버전)를 아는 경우 아래 주석 해제해 컴파일 타임 연동 가능.
        <dependency>
            <groupId>com.nexomc</groupId>
            <artifactId>nexo</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>
        -->
    </dependencies>

    <build>
        <!-- IntelliJ/Maven 빌드 시 접미사 방지 → 결과물: target/MenuPlugin.jar -->
        <finalName>MenuPlugin</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>
</project>
